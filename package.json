{
  "name": "my-portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "cd client && vite",
    "build": "npm run typecheck && cd client && vite build",
    "preview": "cd client && vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "test": "cd client && vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "schema": "node shared/schema/build.ts && biome format --write shared/schema",
    "serve": "node server/local.ts",
    "ingest:local": "node ingest/cli.ts --local"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5"
  }
}
