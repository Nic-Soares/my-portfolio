{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "cd client && vite",
    "build": "deno check client/src/app/main.tsx && cd client && vite build",
    "preview": "cd client && vite preview",
    "typecheck": "deno check client/src/app/main.tsx",
    "test": "cd client && vitest run",
    "lint": "deno run -A npm:@biomejs/biome@2 lint .",
    "format": "deno run -A npm:@biomejs/biome@2 format --write .",
    "check": "deno run -A npm:@biomejs/biome@2 check --write ."
  },
  "imports": {
    "@testing-library/jest-dom": "npm:@testing-library/jest-dom@^7.0.1",
    "@testing-library/react": "npm:@testing-library/react@^16.3.3",
    "jsdom": "npm:jsdom@^30.1.3",
    "react": "npm:react@^19.3.1",
    "react/": "npm:/react@^19.3.1/",
    "react-dom": "npm:react-dom@^19.3.1",
    "react-dom/client": "npm:react-dom@^19.3.1/client",
    "react-router-dom": "npm:react-router-dom@^7.18.4",
    "clsx": "npm:clsx@^2.1.1",
    "@types/react": "npm:@types/react@^19.3.0",
    "@types/react-dom": "npm:@types/react-dom@^19.3.0",
    "@material/web/": "npm:/@material/web@^2.5.0/",
    "vite": "npm:vite@^8.3.5",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^6.1.2",
    "vite-plugin-svgr": "npm:vite-plugin-svgr@^5.2.0",
    "@/": "./client/src/",
    "@assets/": "./client/src/assets/",
    "vitest": "npm:vitest@^5.0.5"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "fmt": {
    "exclude": ["dist", "node_modules"]
  },
  "lint": {
    "exclude": ["dist", "node_modules"]
  }
}
