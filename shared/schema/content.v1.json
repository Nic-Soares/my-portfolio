{
  "title": "Portfolio project content (.portfolio/content.<locale>.json)",
  "description": "Text fields are Markdown: **bold**, *italic*, `code`, [links](https://…), paragraphs and lists. No HTML.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "heroAlt": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["label", "value"]
      }
    },
    "tabs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "sidebarItems": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "anchorId": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]+$"
                }
              },
              "required": ["label", "anchorId"]
            }
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": ["id", "title", "sidebarItems", "content"]
      }
    }
  },
  "required": ["name", "description", "context", "tabs"],
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "header"
            },
            "level": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 3
                }
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "level", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "paragraph"
            },
            "text": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "intro"
            },
            "text": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            }
          },
          "required": ["type", "text"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "image"
            },
            "src": {
              "type": "string",
              "pattern": "^images\\/[\\w./-]+\\.(png|jpe?g|webp)$"
            },
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "aspectRatio": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)? \\/ \\d+(\\.\\d+)?$"
            },
            "caption": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "src", "alt"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "code"
            },
            "code": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "title": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "code", "language"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "list"
            },
            "items": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "ordered": {
              "type": "boolean"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "items"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "video"
            },
            "src": {
              "type": "string",
              "format": "uri"
            },
            "alt": {
              "type": "string"
            },
            "aspectRatio": {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)? \\/ \\d+(\\.\\d+)?$"
            },
            "caption": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "src"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "table"
            },
            "headers": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "headers", "rows"]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "columns"
            },
            "columns": {
              "minItems": 2,
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/__schema0"
                }
              }
            },
            "layout": {
              "type": "string",
              "pattern": "^\\d+(-\\d+)+$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "snug": {
              "type": "boolean"
            }
          },
          "required": ["type", "columns"]
        }
      ]
    }
  }
}
