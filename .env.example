# Local server (npm run serve). Nothing here is secret.
PORT=3000
# Absolute origin for canonical, Open Graph and the sitemap
SITE_URL=http://localhost:3000
# Folder of projects with a .portfolio/ each (default: server/fixtures/projects)
# PROJECTS_DIR=

# Client build (npm run build)
# VITE_SITE_URL=https://your-domain

# ---- Secrets: never in this file or in the repo (docs/runbooks/keys.md) ----
# GitHub Actions secrets (EP-16): PORTFOLIO_GITHUB_TOKEN, R2_ACCESS_KEY_ID,
#   R2_SECRET_ACCESS_KEY; (EP-18): CLOUDFLARE_API_TOKEN
# GitHub Actions variables: CLOUDFLARE_ACCOUNT_ID, R2_BUCKET
